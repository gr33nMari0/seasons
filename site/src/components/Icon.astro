---
// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
// A pixel UI icon from design/icons.svg, in the text's colour.
interface Props { name: string; label?: string; class?: string }
const { name, label, class: cls } = Astro.props
---
<svg class:list={['px-icon', cls]} viewBox="0 0 16 16" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><use href={`/design/icons.svg#${name}`} /></svg>
