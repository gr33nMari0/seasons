{
  "name": "seasons-site",
  "private": true,
  "description": "The public Seasons site and docs (Astro and Starlight, ADR 0008). Published by GitHub Pages from dist/.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev",
    "build": "node scripts/prepare.mjs && astro build && node scripts/csp.mjs && node scripts/og.mjs",
    "preview": "astro preview",
    "test": "node --test --test-reporter=spec test/*.test.mjs && node --test --test-concurrency=1 --test-reporter=spec test/*.spec.mjs",
    "unit": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.10",
    "@axe-core/playwright": "4.14.0",
    "astro": "7.4.8",
    "playwright": "1.65.0",
    "starlight-links-validator": "0.27.0"
  }
}
